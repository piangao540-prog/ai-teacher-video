    {
      "template": "CodeTyping",
      "say": ["先看第一个问题。"],
      "props": {
        "fileName": "ref-vs-reactive.ts",
        "lines": [
          { "code": "import { ref, reactive } from 'vue'" },
          { "code": "const count = ref(0)", "say": "用 ref 定义一个计数器，初始值是 0。" },
          { "code": "count.value  // 0", "say": "取值的时候必须加 value，这是 ref 的规矩。" },
          { "code": "const state = reactive({ n: 0 })", "say": "用 reactive 定义一个对象，里面放一个 n。" },
          { "code": "state.n  // 0", "say": "对象属性可以直接访问，不需要加 value。" }
        ]
      }
