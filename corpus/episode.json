        "fileName": "toRefs-demo.js",
        "lines": [
          {
            "code": "const state = reactive({ count: 0 })",
            "part": 11
          },
          {
            "code": "const { count } = state  // 丢失响应式",
            "part": 12
          },
          {
            "code": "const { count } = toRefs(state)  // 保留响应式",
            "part": 14
          }
