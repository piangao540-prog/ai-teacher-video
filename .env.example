# 抄成 .env 再填。.env 在 .gitignore 里，不会被提交。
# 说明见 README.md 的「快速开始」。

# TTS：edge（免费、24kHz、官方词级时间戳）或 xfyun
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 只有 TTS_PROVIDER=xfyun 才要这三行
XFYUN_APPID=
XFYUN_APIKEY=
XFYUN_APISECRET=

# 大模型：任何 OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_ATTEMPTS=5
